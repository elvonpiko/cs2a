package web

templ AccessPage(nav *NavUser, toast *Toast, v AccessView) {
	<div class="page-head">
		<h1>Access</h1>
		<p>Server password and SteamID whitelist. Changes apply live via RCON / the whitelist plugin.</p>
	</div>

	if toast != nil && toast.Message != "" {
		if toast.Kind == "ok" {
			<div class="notice">{ toast.Message }</div>
		} else {
			<div class="error-box">{ toast.Message }</div>
		}
	}

	<div class="grid cols-2">
		<div class="card">
			<h2>Server password</h2>
			<p class="sub">sv_password — applied live, no restart needed</p>
			<form method="post" action="/access/password">
				<label class="field">
					<span>New password</span>
					<input type="text" name="password" value={ v.Password } placeholder="empty = no password" autocomplete="off"/>
				</label>
				<div class="btn-row">
					<button class="btn primary" type="submit">Set password</button>
				</div>
				<p class="hint">Setting a password stops random players from joining. Clear it to make the server public again.</p>
			</form>
		</div>

		<div class="card">
			<h2>Whitelist</h2>
			<p class="sub">
				if v.WhitelistActive {
					<span class="badge orange">enforced</span>
				} else {
					<span class="badge grey">inactive</span>
				}
				{' '}requires the CS2 Whitelist plugin; empty list = open server
			</p>
			<form method="post" action="/access/whitelist">
				<label class="field">
					<span>Allowed SteamIDs (one per line — SteamID64, [U:1:x] or STEAM_1:y:z)</span>
					<textarea name="steamids" rows="9" class="mono" spellcheck="false">{ v.WhitelistText }</textarea>
				</label>
				<div class="btn-row">
					<button class="btn primary" type="submit">Save whitelist</button>
					<a class="btn ghost" href="/users">Pick from panel users</a>
				</div>
				<p class="hint">Entries are normalized to SteamID64. Players linked in the panel appear here with one click.</p>
			</form>
		</div>
	</div>

	<div class="card section-gap">
		<h2>Panel users</h2>
		<p class="sub">Accounts that can sign into this panel</p>
		<table class="tbl">
			<thead>
				<tr><th>User</th><th>Role</th><th>SteamID64</th><th></th></tr>
			</thead>
			<tbody>
				for _, u := range v.Users {
					<tr>
						<td>{ u.Username }</td>
						<td><span class={ "role-badge", templ.KV("admin", u.Role == "admin"), templ.KV("player", u.Role != "admin") }>{ u.Role }</span></td>
						<td class="mono">
							if u.SteamID != "" {
								{ u.SteamID }
							} else {
								<span class="faint">not linked</span>
							}
						</td>
						<td style="text-align:right">
							if u.SteamID != "" {
								<form method="post" action="/access/whitelist/add-user" class="mt0">
									<input type="hidden" name="user_id" value={ fmtInt64(u.ID) }/>
									<button class="btn sm" type="submit">Add to whitelist</button>
								</form>
							}
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}

templ UsersPage(nav *NavUser, toast *Toast, v UsersView, selfID int64) {
	<div class="page-head">
		<h1>Users</h1>
		<p>Panel accounts. Players sign in to see server info and manage their loadout.</p>
	</div>

	if toast != nil && toast.Message != "" {
		if toast.Kind == "ok" {
			<div class="notice">{ toast.Message }</div>
		} else {
			<div class="error-box">{ toast.Message }</div>
		}
	}

	<div class="grid cols-2">
		<div class="card">
			<h2>Create account</h2>
			<p class="sub">Admins manage the server; players get the player view</p>
			<form method="post" action="/users/create">
				<label class="field"><span>Username</span><input type="text" name="username" required minlength="2" maxlength="32"/></label>
				<label class="field"><span>Password (min 8 chars)</span><input type="password" name="password" required minlength="8" maxlength="128"/></label>
				<label class="field">
					<span>Role</span>
					<select name="role">
						<option value="player">player</option>
						<option value="admin">admin</option>
					</select>
				</label>
				<label class="field"><span>SteamID (optional — SteamID64, [U:1:x] or STEAM_1:y:z)</span><input type="text" name="steamid" placeholder="[U:1:1234567]"/></label>
				<button class="btn primary" type="submit">Create user</button>
			</form>
		</div>

		<div class="card">
			<h2>Accounts</h2>
			<p class="sub">{ fmtInt(len(v.Users)) } users</p>
			<table class="tbl">
				<thead><tr><th>User</th><th>Role</th><th>SteamID</th><th></th></tr></thead>
				<tbody>
					for _, u := range v.Users {
						<tr>
							<td>{ u.Username }</td>
							<td><span class={ "role-badge", templ.KV("admin", u.Role == "admin"), templ.KV("player", u.Role != "admin") }>{ u.Role }</span></td>
							<td class="mono">{ u.SteamID }</td>
							<td style="text-align:right">
								if u.ID != selfID {
									<form method="post" action="/users/delete" class="mt0">
										<input type="hidden" name="user_id" value={ fmtInt64(u.ID) }/>
										<button class="btn danger sm" type="submit" data-confirm={ "Delete user " + u.Username + "?" }>Delete</button>
									</form>
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
}

templ LoadoutPage(nav *NavUser, toast *Toast, v LoadoutView) {
	<div class="page-head">
		<h1>Loadout</h1>
		<p>Your cosmetics for this server — applied automatically when you connect. In game, <span class="mono">!wp</span> refreshes without reconnecting.</p>
	</div>

	if toast != nil && toast.Message != "" {
		if toast.Kind == "ok" {
			<div class="notice" id="flash">{ toast.Message }</div>
		} else {
			<div class="error-box" id="flash">{ toast.Message }</div>
		}
	}

	if v.SteamID == "" {
		<div class="card">
			<h2>Link your SteamID</h2>
			<p class="muted">
				An admin has not linked a SteamID to your account yet, so your loadout cannot be applied in-game.
				Ask an admin to add your SteamID64 — you can find it on your Steam profile.
			</p>
		</div>
	} else {
		if !v.SyncEnabled {
			<div class="notice">
				Skins sync is not active on this server yet. An admin needs to install the
				<b>WeaponPaints</b> plugin (Plugins page) and configure its MySQL database.
			</div>
		}
		<form method="post" action="/loadout" id="loadout-form">
			<div class="loadout-grid">
				<!-- T side -->
				<div class="card">
					<h2>Terrorist side</h2>
					<p class="sub">steamid <span class="mono">{ v.SteamID }</span></p>

					<h3 class="lo-cat">Knife</h3>
					<div class="lo-row" data-kind="knife_t" data-current={ v.KnifeT }>
						for _, k := range v.KnifeNames {
							<label class={ "item-card", templ.KV("selected", k.Value == v.KnifeT) }>
								<input type="radio" name="knife_t" value={ k.Value } checked?={ k.Value == v.KnifeT }/>
								if k.Value == "default" {
									<span class="item-img placeholder">—</span>
								} else {
									<img class="item-img" src={ "/static/img/knives/" + k.Value + ".png" } alt={ k.Label } loading="lazy"/>
								}
								<span class="item-name">{ k.Label }</span>
							</label>
						}
					</div>

					<h3 class="lo-cat">Gloves</h3>
					<div class="lo-row" data-kind="gloves_t" data-current={ v.GlovesT }>
						for _, g := range v.Gloves {
							<label class={ "item-card", templ.KV("selected", g.Value == v.GlovesT) }>
								<input type="radio" name="gloves_t" value={ g.Value } checked?={ g.Value == v.GlovesT }/>
								if g.Image != "" {
									<img class="item-img" src={ g.Image } alt={ g.Label } loading="lazy"/>
								} else {
									<span class="item-img placeholder">—</span>
								}
								<span class="item-name">{ g.Label }</span>
							</label>
						}
					</div>

					<h3 class="lo-cat">Agent</h3>
					<div class="lo-row" data-kind="agent_t" data-current={ v.AgentT }>
						for _, a := range v.AgentsT {
							<label class={ "item-card", templ.KV("selected", a.Value == v.AgentT) }>
								<input type="radio" name="agent_t" value={ a.Value } checked?={ a.Value == v.AgentT }/>
								if a.Image != "" {
									<img class="item-img" src={ a.Image } alt={ a.Label } loading="lazy"/>
								} else {
									<span class="item-img placeholder">—</span>
								}
								<span class="item-name">{ a.Label }</span>
							</label>
						}
					</div>
				</div>

				<!-- CT side -->
				<div class="card">
					<h2>CT side</h2>
					<p class="sub">Pick different cosmetics for the counter-terrorist side</p>

					<h3 class="lo-cat">Knife</h3>
					<div class="lo-row" data-kind="knife_ct" data-current={ v.KnifeCT }>
						for _, k := range v.KnifeNames {
							<label class={ "item-card", templ.KV("selected", k.Value == v.KnifeCT) }>
								<input type="radio" name="knife_ct" value={ k.Value } checked?={ k.Value == v.KnifeCT }/>
								if k.Value == "default" {
									<span class="item-img placeholder">—</span>
								} else {
									<img class="item-img" src={ "/static/img/knives/" + k.Value + ".png" } alt={ k.Label } loading="lazy"/>
								}
								<span class="item-name">{ k.Label }</span>
							</label>
						}
					</div>

					<h3 class="lo-cat">Gloves</h3>
					<div class="lo-row" data-kind="gloves_ct" data-current={ v.GlovesCT }>
						for _, g := range v.Gloves {
							<label class={ "item-card", templ.KV("selected", g.Value == v.GlovesCT) }>
								<input type="radio" name="gloves_ct" value={ g.Value } checked?={ g.Value == v.GlovesCT }/>
								if g.Image != "" {
									<img class="item-img" src={ g.Image } alt={ g.Label } loading="lazy"/>
								} else {
									<span class="item-img placeholder">—</span>
								}
								<span class="item-name">{ g.Label }</span>
							</label>
						}
					</div>

					<h3 class="lo-cat">Agent</h3>
					<div class="lo-row" data-kind="agent_ct" data-current={ v.AgentCT }>
						for _, a := range v.AgentsCT {
							<label class={ "item-card", templ.KV("selected", a.Value == v.AgentCT) }>
								<input type="radio" name="agent_ct" value={ a.Value } checked?={ a.Value == v.AgentCT }/>
								if a.Image != "" {
									<img class="item-img" src={ a.Image } alt={ a.Label } loading="lazy"/>
								} else {
									<span class="item-img placeholder">—</span>
								}
								<span class="item-name">{ a.Label }</span>
							</label>
						}
					</div>
				</div>
			</div>

			<div class="btn-row section-gap">
				<button class="btn primary" type="submit">Save loadout</button>
				<button class="btn ghost" type="button" data-act="reset-loadout">Reset to defaults</button>
			</div>
			<p class="hint">Cosmetics are server-side only — other players see them, your inventory does not change. Your selection is stored per SteamID64 and applied server-side when the map loads you in.</p>
		</form>
	}
}
