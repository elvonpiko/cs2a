package web

templ SettingsPage(nav *NavUser, toast *Toast, v SettingsView) {
	<div class="page-head">
		<h1>Settings</h1>
		<p>Server rules as CS2 cvars. Fields start at the standard competitive values (the rules a Premier/competitive match runs), so you can change one field and save — everything else keeps the standard you see. Saved to server.cfg (so they survive restarts) and pushed to the running server immediately.</p>
	</div>

	if toast != nil && toast.Message != "" {
		if toast.Kind == "ok" {
			<div class="notice" id="flash">{ toast.Message }</div>
		} else {
			<div class="error-box" id="flash">{ toast.Message }</div>
		}
	}
	if v.CFGWarning != "" {
		<div class="error-box">{ v.CFGWarning }</div>
	}

	if v.AgentDown {
		<div class="card">
			<h2>Settings unavailable</h2>
			<p class="sub">The agent could not read the current server.cfg</p>
			<p class="hint">Saving without knowing what is already there could overwrite it — cs2a refuses. Check the agent is running, then reload this page.</p>
		</div>
	} else {
		<form method="post" action="/settings" class="grow">
			for _, g := range v.Groups {
				<div class="card section-gap">
					<h2>{ g.Title }</h2>
					<p class="sub">{ g.Blurb }</p>
					for _, row := range g.Rows {
						<label class="field">
							<span>{ row.Label } <span class="mono faint">{ row.Name }</span></span>
							switch row.Kind {
								case "bool":
									<select name={ "set_" + row.Name }>
										<option value="0" selected?={ row.EffectiveValue() == "0" }>off</option>
										<option value="1" selected?={ row.EffectiveValue() == "1" }>on</option>
									</select>
								case "select":
									<select name={ "set_" + row.Name }>
										for _, o := range row.Options {
											<option value={ o.Value } selected?={ row.EffectiveValue() == o.Value }>{ o.Label }</option>
										}
									</select>
								case "int":
									<input type="number" name={ "set_" + row.Name } value={ row.EffectiveValue() } min={ fmtFloat(row.Min) } max={ fmtFloat(row.Max) } step="1"/>
								case "float":
									<input type="number" name={ "set_" + row.Name } value={ row.EffectiveValue() } min={ fmtFloat(row.Min) } max={ fmtFloat(row.Max) } step="any"/>
								default:
									<input type="text" name={ "set_" + row.Name } value={ row.EffectiveValue() }/>
							}
							<p class="hint">{ row.Hint }</p>
						</label>
					}
				</div>
			}
			<div class="btn-row section-gap sticky-actions">
				<button class="btn primary" type="submit">Save settings</button>
				<button
					class="btn ghost"
					type="submit"
					formaction="/settings/reset"
					data-confirm="Set every server setting back to the standard competitive rules (24 rounds, MR12 economy, 40s C4, no bots)? Your saved changes are overwritten."
				>Reset to competitive defaults</button>
				<a class="btn ghost" href="/settings">Undo edits</a>
			</div>
		</form>
		// sv_password lives on the Access page (it is access control, and its
		// save path reloads the map so enforcement is immediate).
		// mp_warmup_start / mp_warmup_end are deliberately not here either:
		// they are commands, not settings, and the server already runs its
		// warmup phase by itself between maps — the length field above is
		// the part that is actually a setting.
		if v.ExtraCount > 0 {
			<p class="hint section-gap">{ fmtInt(v.ExtraCount) } other { plural(v.ExtraCount, "setting", "settings") } live in the managed block outside this catalog (advanced cvars, plugin config). Saving here keeps them untouched.</p>
		}
	}
}

templ AccessPage(nav *NavUser, toast *Toast, v AccessView) {
	<div class="page-head">
		<h1>Access</h1>
		<p>Server password and SteamID whitelist. Changes apply live via RCON / the whitelist plugin.</p>
	</div>

	if toast != nil && toast.Message != "" {
		if toast.Kind == "ok" {
			<div class="notice" id="flash">{ toast.Message }</div>
		} else {
			<div class="error-box" id="flash">{ toast.Message }</div>
		}
	}
	// A second cs2a block in server.cfg wins in-game over the one this page
	// writes, so a save appears to do nothing. Saying so is the only way the
	// operator can find out.
	if v.CFGWarning != "" {
		<div class="error-box">{ v.CFGWarning }</div>
	}

	// The two controls below are independent layers, and operators kept
	// reading them as one feature: "I set a password, why can strangers
	// join?". One strip states the current mode and what actually gates a
	// connection. Panel accounts are deliberately not a layer here: they
	// gate this web panel only, and that line lives on the Users page where
	// the accounts are — stating it here made admins read "panel user" as an
	// in-game access level.
	<div class="card access-summary">
		<div class="row between">
			<h2>Who can join right now</h2>
			<span class={ "badge", templ.KV("green", v.Password != "" || v.WhitelistActive), templ.KV("grey", v.Password == "" && !v.WhitelistActive) }>{ v.AccessModeLabel() }</span>
		</div>
		<p class="sub">{ v.AccessModeDetail() }</p>
		<div class="access-layers">
			<div class={ "layer", templ.KV("on", v.Password != "") }>
				<b>Password</b>
				<span>Anyone with the password. Clients cache it after the first successful connect — the same player reconnects without typing it again, which looks like "no password needed".</span>
			</div>
			<div class={ "layer", templ.KV("on", v.WhitelistActive), templ.KV("off", v.WhitelistInstalled && !v.WhitelistActive), templ.KV("na", !v.WhitelistInstalled) }>
				<b>Restrictive access</b>
				if v.WhitelistInstalled {
					<span>Closes the server entirely: only whitelisted SteamIDs can connect, everyone else is rejected at the door — even ones who know the password. Independent of the password: with both on, a listed player needs the password too.</span>
				} else {
					<span>Closes the server entirely — only whitelisted SteamIDs could connect. Needs the <a href="/plugins">CS2 Whitelist plugin</a> first; install it there and the management card appears on this page.</span>
				}
			</div>
		</div>
	</div>

	<div class="grid cols-2">
		<div class="card">
			<h2>Server password</h2>
			<p class="sub">
				if v.Password != "" {
					<span class="badge green">protected</span>
				} else {
					<span class="badge grey">open to everyone</span>
				}
				sv_password — saving reloads the map so it locks right away
			</p>
			// The password itself is never echoed back: this page is readable
			// by any admin, and a secret displayed on screen stops being a
			// secret. The badge says whether one is set; the input always
			// starts empty and overwrites on save.
			<form method="post" action="/access/password" class="grow">
				<label class="field">
					<span>{ labelPasswordCard(v.Password) }</span>
					<input type="password" name="password" placeholder={ placeholderPasswordCard(v.Password) } autocomplete="new-password"/>
				</label>
				<div class="card-foot">
					<div class="btn-row">
						<button class="btn primary" type="submit">{ submitLabelPasswordCard(v.Password) }</button>
					</div>
					<p class="hint">Setting a password stops random players from joining — the map reloads so it locks right away. Clear it to make the server public again.</p>
				</div>
			</form>
		</div>

		if v.WhitelistInstalled {
			<div class="card">
				<h2>Restrictive access</h2>
				<p class="sub">
					if v.WhitelistActive {
						<span class="badge orange">enforced</span>
					} else {
						<span class="badge grey">inactive</span>
					}
					Only whitelisted SteamIDs connect — enforced by the CS2 Whitelist plugin
				</p>
				<div class="row between mt8">
					<span class="faint">
						{ fmtInt(v.WhitelistCount) } allowed { plural(v.WhitelistCount, "player", "players") }
					</span>
					<form method="post" action="/access/whitelist/toggle" class="switch-form mt0">
						if v.WhitelistActive {
							<input type="hidden" name="enabled" value="0"/>
							<button class="switch on" type="submit" role="switch" aria-checked="true">
								<span class="track" aria-hidden="true"></span>
								<span>Enforcing</span>
							</button>
						} else if v.WhitelistCount == 0 {
							// The agent refuses to enforce an empty list, because
							// that rejects every player including the operator. An
							// enabled switch that always fails is worse than one the
							// page explains: it stays off until there is an entry.
							<button class="switch" type="button" disabled aria-disabled="true" title="Add at least one SteamID first">
								<span class="track" aria-hidden="true"></span>
								<span>Off</span>
							</button>
						} else {
							<input type="hidden" name="enabled" value="1"/>
							<button
								class="switch"
								type="submit"
								role="switch"
								aria-checked="false"
								data-confirm-danger
								data-confirm={ whitelistEnableWarning(v.WhitelistCount) }
							>
								<span class="track" aria-hidden="true"></span>
								<span>Off</span>
							</button>
						}
					</form>
				</div>
				<hr class="divider"/>
				// The list of who is allowed, one row per player, with a remove
				// button each. A textarea of raw SteamIDs made the admin decode
				// 17-digit ids to answer "is my friend on the list?".
				if len(v.WhitelistPlayers) == 0 {
					<p class="hint">No one is whitelisted yet. Add players below — enforcement stays off until the list has an entry.</p>
				} else {
					<div class="scroll-y wl-list">
						for _, p := range v.WhitelistPlayers {
							<div class="wl-row">
								<div class="wl-who">
									if p.Name != "" {
										<b>{ p.Name }</b>
									} else {
										<b class="faint">unlinked player</b>
									}
									<span class="mono faint">{ p.SteamID }</span>
								</div>
								<form method="post" action="/access/whitelist/remove" class="mt0">
									<input type="hidden" name="steamid" value={ p.SteamID }/>
									<button class="btn ghost sm" type="submit" data-confirm={ "Remove " + whitelistPlayerName(p.Name) + " from the whitelist? They can no longer connect." }>Remove</button>
								</form>
							</div>
						}
					</div>
				}
				// Raw-entry form for ids without panel accounts. Panel users are
				// added from the modal below; this stays for the friend who will
				// never sign into the panel.
				<form method="post" action="/access/whitelist" class="grow mt8">
					<label class="field">
						<span>Add SteamIDs directly (one per line — SteamID64, [U:1:x] or STEAM_1:y:z)</span>
						<textarea name="steamids" rows="3" class="mono tall" spellcheck="false" placeholder={ "76561197960287930\n[U:1:1234567]" }></textarea>
					</label>
					<div class="card-foot">
						<div class="btn-row">
							<button class="btn primary" type="submit">Add SteamIDs</button>
						</div>
						<p class="hint">Appends to the list — existing entries are kept. Entries are normalized to SteamID64.</p>
					</div>
				</form>
				<div class="card-foot">
					<div class="btn-row">
						<button class="btn" type="button" data-wl-add>
							Add players from panel users
						</button>
						<a class="btn ghost" href="/users">Manage accounts</a>
					</div>
					<p class="hint">Only panel users with a linked SteamID can be added this way — a player with no SteamID has nothing to whitelist.</p>
				</div>
			</div>
			// The add-players modal: every panel user with a linked, not-yet-
			// whitelisted SteamID as a checkbox. A native <dialog> keeps this
			// dependency-free and styled by the panel's own CSS.
			<dialog id="wl-add-modal" class="modal">
				<form method="post" action="/access/whitelist/add-users">
					<h3>Add players to the whitelist</h3>
					if len(v.AddableUsers) == 0 {
						<p class="sub">Every panel user with a linked SteamID is already whitelisted. Link a SteamID on the Users page to add more.</p>
					} else {
						<div class="scroll-y wl-picks">
							for _, uu := range v.AddableUsers {
								<label class="wl-pick">
									<input type="checkbox" name="user_id" value={ fmtInt64(uu.ID) }/>
									<span class="wl-who">
										<b>{ uu.Username }</b>
										<span class="mono faint">{ uu.SteamID }</span>
									</span>
								</label>
							}
						</div>
					}
					<div class="btn-row mt8">
						if len(v.AddableUsers) > 0 {
							<button class="btn primary" type="submit">Add selected</button>
						}
						<button class="btn ghost" type="button" data-wl-close>Cancel</button>
					</div>
				</form>
			</dialog>
		} else {
			// The card is intentionally absent until the plugin exists; this
			// placeholder keeps the grid from collapsing the password card to
			// full width, which would make the layout jump when the plugin is
			// installed. It says what to do in one line and links there — it is
			// a pointer, not a control surface.
			<div class="card ghost-card">
				<h2>Restrictive access</h2>
				<p class="sub">Only whitelisted SteamIDs connect</p>
				<p class="faint">
					Install the <a href="/plugins">CS2 Whitelist plugin</a> to manage who can join. Nothing is shown here until then.
				</p>
			</div>
		}
	</div>

}

templ UsersPage(nav *NavUser, toast *Toast, v UsersView, selfID int64) {
	<div class="page-head">
		<h1>Users</h1>
		<p>Panel accounts. Players sign in to see server info and manage their loadout.</p>
		// Panel accounts are web-panel only: they never grant or gate in-game
		// access. That line lives here — the page where accounts are created —
		// because on the Access page it was read as "panel users are an access
		// level of the server", which they are not.
		<p class="hint">These accounts sign into this panel only — they do not affect who can join the game server (that is the Access page). Linking a SteamID lets a user manage their loadout and be added to the server whitelist, but never lets them connect by itself.</p>
	</div>

	if toast != nil && toast.Message != "" {
		if toast.Kind == "ok" {
			<div class="notice" id="flash">{ toast.Message }</div>
		} else {
			<div class="error-box" id="flash">{ toast.Message }</div>
		}
	}

	<div class="grid cols-2">
		<div class="card">
			<h2>Create account</h2>
			<p class="sub">Admins manage the server; players get the player view</p>
			<form method="post" action="/users/create" class="grow">
				<label class="field"><span>Username</span><input type="text" name="username" required minlength="2" maxlength="32"/></label>
				<label class="field"><span>Password (min 8 chars)</span><input type="password" name="password" required minlength="8" maxlength="128"/></label>
				<label class="field">
					<span>Role</span>
					<select name="role">
						<option value="player">player</option>
						<option value="admin">admin</option>
					</select>
				</label>
				<label class="field"><span>SteamID (optional — SteamID64, [U:1:x] or STEAM_1:y:z)</span><input type="text" name="steamid" placeholder="[U:1:1234567]"/></label>
				<div class="card-foot">
					<button class="btn primary" type="submit">Create user</button>
				</div>
			</form>
		</div>

		<div class="card">
			<h2>Accounts</h2>
			<p class="sub">{ fmtInt(len(v.Users)) } { plural(len(v.Users), "user", "users") }</p>
			<div class="scroll-y">
				<table class="tbl">
					<thead><tr><th scope="col">User</th><th scope="col">Role</th><th scope="col">SteamID</th><th><span class="sr-only">Actions</span></th></tr></thead>
					<tbody>
						for _, u := range v.Users {
							<tr>
								<td>{ u.Username }</td>
								<td><span class={ "role-badge", templ.KV("admin", u.Role == "admin"), templ.KV("player", u.Role != "admin") }>{ u.Role }</span></td>
								<td class="mono">
									if u.SteamID != "" {
										{ u.SteamID }
									} else {
										<span class="faint">not linked</span>
									}
								</td>
								<td class="right">
									if u.ID != selfID {
										<div class="btn-row">
											// Promote/demote without the delete-recreate dance. A
											// player becomes an admin in one click; demoting the
											// last admin is refused server-side.
											<form method="post" action="/users/role" class="mt0">
												<input type="hidden" name="user_id" value={ fmtInt64(u.ID) }/>
												if u.Role == "admin" {
													<button class="btn ghost sm" type="submit" data-confirm={ "Demote " + u.Username + " to player?" }>Demote</button>
												} else {
													<button class="btn ghost sm" type="submit" data-confirm={ "Promote " + u.Username + " to admin? They get full control of the server." }>Promote</button>
												}
											</form>
											<form method="post" action="/users/delete" class="mt0">
												<input type="hidden" name="user_id" value={ fmtInt64(u.ID) }/>
												<button class="btn danger sm" type="submit" data-confirm={ "Delete user " + u.Username + "? They lose access to the panel immediately." }>Delete</button>
											</form>
										</div>
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</div>
	</div>
}

templ LoadoutPage(nav *NavUser, toast *Toast, v LoadoutView) {
	<div class="page-head">
		<h1>Loadout</h1>
		<p>Your cosmetics for this server — applied automatically when you connect. In game, <span class="mono">!wp</span> refreshes without reconnecting.</p>
	</div>

	if toast != nil && toast.Message != "" {
		if toast.Kind == "ok" {
			<div class="notice" id="flash">{ toast.Message }</div>
		} else {
			<div class="error-box" id="flash">{ toast.Message }</div>
		}
	}

	if v.SteamID == "" {
		<div class="card">
			<h2>Link your SteamID</h2>
			<p class="muted">
				An admin has not linked a SteamID to your account yet, so your loadout cannot be applied in-game.
				Ask an admin to add your SteamID64 — you can find it on your Steam profile.
			</p>
		</div>
	} else {
		if !v.SyncEnabled {
			<div class="notice">
				Skins sync is not active on this server yet. An admin needs to install the
				<b>WeaponPaints</b> plugin (Plugins page) and configure its MySQL database.
			</div>
		}
		<form method="post" action="/loadout" id="loadout-form">
			<div class="loadout-grid">
				<!-- T side -->
				<div class="card">
					<h2>Terrorist side</h2>
					<p class="sub">steamid <span class="mono">{ v.SteamID }</span></p>

					<h3 class="lo-cat">Knife</h3>
					<div class="lo-row">
						for _, k := range v.KnifeNames {
							<label class={ "item-card", templ.KV("selected", k.Value == v.KnifeT) }>
								<input type="radio" name="knife_t" value={ k.Value } checked?={ k.Value == v.KnifeT }/>
								if k.Value == "default" {
									<span class="item-img placeholder">—</span>
								} else {
									<img class="item-img" src={ "/static/img/knives/" + k.Value + ".png" } alt={ k.Label } loading="lazy"/>
								}
								<span class="item-name">{ k.Label }</span>
							</label>
						}
					</div>

					<h3 class="lo-cat">Gloves</h3>
					<div class="lo-row">
						for _, g := range v.Gloves {
							<label class={ "item-card", templ.KV("selected", g.Value == v.GlovesT) }>
								<input type="radio" name="gloves_t" value={ g.Value } checked?={ g.Value == v.GlovesT }/>
								if g.Image != "" {
									<img class="item-img" src={ g.Image } alt={ g.Label } loading="lazy"/>
								} else {
									<span class="item-img placeholder">—</span>
								}
								<span class="item-name">{ g.Label }</span>
							</label>
						}
					</div>

					<h3 class="lo-cat">Agent</h3>
					<div class="lo-row">
						for _, a := range v.AgentsT {
							<label class={ "item-card", templ.KV("selected", a.Value == v.AgentT) }>
								<input type="radio" name="agent_t" value={ a.Value } checked?={ a.Value == v.AgentT }/>
								if a.Image != "" {
									<img class="item-img" src={ a.Image } alt={ a.Label } loading="lazy"/>
								} else {
									<span class="item-img placeholder">—</span>
								}
								<span class="item-name">{ a.Label }</span>
							</label>
						}
					</div>

					for _, w := range weaponSkinsFor(v.Weapons, "T") {
						<h3 class="lo-cat">{ w.Name }</h3>
						<div class="lo-row">
							<label class={ "item-card", templ.KV("selected", skinPick(v.SkinT, w.DefindexLabel) == "") }>
								<input type="radio" name={ w.NameT } value="" checked?={ skinPick(v.SkinT, w.DefindexLabel) == "" }/>
								<span class="item-img placeholder">—</span>
								<span class="item-name">Vanilla</span>
							</label>
							for _, sk := range w.Skins {
								<label class={ "item-card", templ.KV("selected", skinPick(v.SkinT, w.DefindexLabel) == sk.Value) }>
									<input type="radio" name={ w.NameT } value={ sk.Value } checked?={ skinPick(v.SkinT, w.DefindexLabel) == sk.Value }/>
									if sk.Image != "" {
										<img class="item-img" src={ sk.Image } alt={ sk.Label } loading="lazy"/>
									} else {
										<span class="item-img placeholder">—</span>
									}
									<span class="item-name">{ sk.Label }</span>
								</label>
							}
						</div>
					}
				</div>

				<!-- CT side -->
				<div class="card">
					<h2>CT side</h2>
					<p class="sub">Pick different cosmetics for the counter-terrorist side</p>

					<h3 class="lo-cat">Knife</h3>
					<div class="lo-row">
						for _, k := range v.KnifeNames {
							<label class={ "item-card", templ.KV("selected", k.Value == v.KnifeCT) }>
								<input type="radio" name="knife_ct" value={ k.Value } checked?={ k.Value == v.KnifeCT }/>
								if k.Value == "default" {
									<span class="item-img placeholder">—</span>
								} else {
									<img class="item-img" src={ "/static/img/knives/" + k.Value + ".png" } alt={ k.Label } loading="lazy"/>
								}
								<span class="item-name">{ k.Label }</span>
							</label>
						}
					</div>

					<h3 class="lo-cat">Gloves</h3>
					<div class="lo-row">
						for _, g := range v.Gloves {
							<label class={ "item-card", templ.KV("selected", g.Value == v.GlovesCT) }>
								<input type="radio" name="gloves_ct" value={ g.Value } checked?={ g.Value == v.GlovesCT }/>
								if g.Image != "" {
									<img class="item-img" src={ g.Image } alt={ g.Label } loading="lazy"/>
								} else {
									<span class="item-img placeholder">—</span>
								}
								<span class="item-name">{ g.Label }</span>
							</label>
						}
					</div>

					<h3 class="lo-cat">Agent</h3>
					<div class="lo-row">
						for _, a := range v.AgentsCT {
							<label class={ "item-card", templ.KV("selected", a.Value == v.AgentCT) }>
								<input type="radio" name="agent_ct" value={ a.Value } checked?={ a.Value == v.AgentCT }/>
								if a.Image != "" {
									<img class="item-img" src={ a.Image } alt={ a.Label } loading="lazy"/>
								} else {
									<span class="item-img placeholder">—</span>
								}
								<span class="item-name">{ a.Label }</span>
							</label>
						}
					</div>

					for _, w := range weaponSkinsFor(v.Weapons, "CT") {
						<h3 class="lo-cat">{ w.Name }</h3>
						<div class="lo-row">
							<label class={ "item-card", templ.KV("selected", skinPick(v.SkinCT, w.DefindexLabel) == "") }>
								<input type="radio" name={ w.NameCT } value="" checked?={ skinPick(v.SkinCT, w.DefindexLabel) == "" }/>
								<span class="item-img placeholder">—</span>
								<span class="item-name">Vanilla</span>
							</label>
							for _, sk := range w.Skins {
								<label class={ "item-card", templ.KV("selected", skinPick(v.SkinCT, w.DefindexLabel) == sk.Value) }>
									<input type="radio" name={ w.NameCT } value={ sk.Value } checked?={ skinPick(v.SkinCT, w.DefindexLabel) == sk.Value }/>
									if sk.Image != "" {
										<img class="item-img" src={ sk.Image } alt={ sk.Label } loading="lazy"/>
									} else {
										<span class="item-img placeholder">—</span>
									}
									<span class="item-name">{ sk.Label }</span>
								</label>
							}
						</div>
					}
				</div>
			</div>

			<div class="btn-row section-gap">
				<button class="btn primary" type="submit">Save loadout</button>
				<button class="btn ghost" type="button" data-act="reset-loadout">Reset to defaults</button>
			</div>
			<p class="hint">Cosmetics are server-side only — other players see them, your inventory does not change. Your selection is stored per SteamID64 and applied server-side when the map loads you in.</p>
		</form>
	}
}
