package web

// Mark is the cs2a logo: a segmented reticle ring with axis ticks and a solid
// core. Drawn as inline SVG so it inherits colour, needs no network request,
// and stays crisp at every size. Sizing comes from CSS (.mark / .mark-big).
templ Mark(class string) {
	<svg class={ class } viewBox="0 0 32 32" fill="none" aria-hidden="true" focusable="false">
		<!-- outer reticle: one dashed ring, gaps centred on the axes -->
		<circle
			class="ring"
			cx="16"
			cy="16"
			r="11"
			stroke="currentColor"
			stroke-width="2"
			stroke-linecap="round"
			stroke-dasharray="11.3 6"
			stroke-dashoffset="-3"
		></circle>
		<!-- axis ticks crossing the gaps -->
		<g stroke="currentColor" stroke-width="2" stroke-linecap="round" opacity="0.5">
			<path d="M16 2.5V6.5"></path>
			<path d="M16 25.5V29.5"></path>
			<path d="M2.5 16H6.5"></path>
			<path d="M25.5 16H29.5"></path>
		</g>
		<!-- core -->
		<circle cx="16" cy="16" r="3.4" fill="currentColor"></circle>
	</svg>
}

// Brand is the topbar lock-up: mark + lowercase wordmark, linking home.
templ Brand() {
	<a class="brand" href="/" aria-label="cs2a home">
		@Mark("mark")
		<span class="wordmark">cs<i>2</i>a</span>
	</a>
}
