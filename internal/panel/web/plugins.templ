package web

templ PluginsPage(nav *NavUser, toast *Toast, entries []PluginCardView, jobs []PluginJobView) {
	<div class="page-head">
		<h1>Plugins</h1>
		<p>Install and manage server-side components. Every install resolves against the live upstream release, so you always get the current version.</p>
	</div>

	if toast != nil && toast.Message != "" {
		if toast.Kind == "ok" {
			<div class="notice" id="flash">{ toast.Message }</div>
		} else {
			<div class="error-box" id="flash">{ toast.Message }</div>
		}
	}

	@PluginJobs(jobs)

	@PluginCards(entries, false)
}

// PluginCards is the catalog grid. It is a separate component so the job strip
// can swap a fresh copy in out-of-band when an install finishes: the cards
// otherwise kept saying "not installed" until the operator reloaded the page.
templ PluginCards(entries []PluginCardView, oob bool) {
	<div
		class="grid cols-3"
		id="plugin-grid"
		if oob {
			hx-swap-oob="true"
		}
	>
		for _, e := range entries {
			<div class="card plugin-card">
				<div class="head">
					<div>
						<h3>{ e.Name }</h3>
						<div class="byline">by { e.Author }</div>
					</div>
					if e.Installed {
						<span class="badge green">installed { e.Version }</span>
					} else {
						<span class="badge grey">not installed</span>
					}
				</div>
				<p>{ e.Description }</p>
				if len(e.Requires) > 0 {
					<div class="req">
						for _, req := range e.Requires {
							<span class="badge blue">needs { req }</span>
						}
					</div>
				}
				<div class="btn-row">
					if e.Installed {
						if e.HasConfig {
							<a class="btn sm" href={ "/plugins/" + e.ID + "/config" }>Configure</a>
						}
						if len(e.RequiredBy) > 0 {
							<span class="faint">Required by { joinList(e.RequiredBy) }</span>
						} else {
							<form method="post" action={ "/plugins/" + e.ID + "/uninstall" } class="mt0">
								<button class="btn danger sm" type="submit" data-confirm={ "Uninstall " + e.Name + "? This removes its files." }>Uninstall</button>
							</form>
						}
					} else {
						<form method="post" action={ "/plugins/" + e.ID + "/install" } class="mt0">
							<button class="btn primary sm" type="submit" data-confirm={ "Install " + e.Name + "?" }>Install</button>
						</form>
					}
					if e.Homepage != "" {
						<a class="btn ghost sm" href={ e.Homepage } target="_blank" rel="noopener noreferrer">Docs</a>
					}
				</div>
			</div>
		}
	</div>
}

// PluginJobs is the live install progress strip. It is polled while any job is
// running and stops polling once everything settles, so installs that take
// minutes report progress without the page holding a request open.
//
// aria-live makes it the announcement channel for installs too: the spinner is
// decorative, so without it a screen-reader user was never told that a
// multi-minute install had finished, failed, or needed a restart.
templ PluginJobs(jobs []PluginJobView) {
	<div
		id="plugin-jobs"
		aria-live="polite"
		if AnyRunning(jobs) {
			hx-get="/partials/plugin-jobs"
			hx-trigger="every 2s"
			hx-swap="outerHTML"
		}
	>
		if len(jobs) > 0 {
			<div class="job-strip">
				for _, j := range jobs {
					<div
						class={ "job-row",
							templ.KV("running", j.Running),
							templ.KV("failed", j.Status == "failed") }
					>
						if j.Running {
							<span class="spinner" aria-hidden="true"></span>
						} else if j.Status == "failed" {
							<span class="badge red">failed</span>
						} else if j.Warning != "" {
							<span class="badge orange">warning</span>
						} else {
							<span class="badge green">done</span>
						}
						<span class="name">{ j.Name }</span>
						if j.Running {
							<span class="step">{ j.Step }</span>
						} else if j.Status == "failed" {
							<span class="step">{ j.Message }</span>
						} else if j.Warning != "" {
							<span class="step">
								installed { j.Version } — { j.Warning }
							</span>
						} else {
							<span class="step">
								installed { j.Version }
								if j.RequiresRestart {
									{ " — restart the server to load it" }
								}
							</span>
						}
					</div>
				}
			</div>
		}
	</div>
}

templ PluginConfigPage(nav *NavUser, toast *Toast, v PluginConfigView) {
	<div class="page-head">
		<h1>{ v.Name } config</h1>
		<p>Edits the plugin's JSON config on the server — validated before an atomic write.</p>
	</div>

	if toast != nil && toast.Message != "" {
		if toast.Kind == "ok" {
			<div class="notice" id="flash">{ toast.Message }</div>
		} else {
			<div class="error-box" id="flash">{ toast.Message }</div>
		}
	}

	<div class="card">
		if !v.Exists {
			<div class="notice">Config file does not exist yet — it is created on first server start. Saving will pre-create it.</div>
		}
		if v.Note != "" {
			<p class="faint">{ v.Note }</p>
		}
		<form method="post" action={ "/plugins/" + v.ID + "/config" } class="grow">
			<label class="field">
				<span>config.json</span>
				<textarea name="json" rows="20" class="mono" spellcheck="false">{ v.JSON }</textarea>
			</label>
			<div class="card-foot">
				<div class="btn-row">
					<button class="btn primary" type="submit">Save config</button>
					<a class="btn ghost" href="/plugins">Back</a>
				</div>
				<p class="hint">Some plugins only read their config at server start — a restart may be required after saving.</p>
			</div>
		</form>
	</div>
}
